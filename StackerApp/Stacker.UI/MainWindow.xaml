<Window x:Class="Stacker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stacker Camera App" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления камерой -->
        <GroupBox Grid.Row="0" Header="Камера" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Камера:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbCameras" Width="200" Margin="0,0,10,0"/>
                    <Button x:Name="BtnConnect" Content="Подключить" Click="BtnConnect_Click" Padding="10,5"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Выдержка (с):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtExposure" Width="60" Text="1.0" Margin="0,0,10,0"/>
                    <Button Content="Старт" Click="BtnStartExposure_Click" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="Стоп" Click="BtnStopExposure_Click" Padding="10,5"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button x:Name="BtnConnectAscom" Content="Подключить ASCOM" Click="BtnConnectAscom_Click" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Область просмотра -->
        <GroupBox Grid.Row="1" Header="Изображение" Margin="0,0,0,10">
            <Grid>
                <Image x:Name="ImgCurrent" Stretch="Uniform" Background="Black"/>
                <TextBlock x:Name="LblFps" Text="FPS: 0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                           Foreground="White" Background="Black" Opacity="0.7" Margin="10"/>
            </Grid>
        </GroupBox>

        <!-- Статус и прогресс -->
        <GroupBox Grid.Row="2" Header="Статус">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="LblStatus" Text="Готов" Margin="5"/>
                <TextBlock x:Name="LblAscomStatus" Text="ASCOM: Отключено" Margin="5"/>
                <ProgressBar x:Name="PrbExposure" Height="20" Minimum="0" Maximum="100" Value="0" Margin="5"/>
                <TextBlock x:Name="LblExposureInfo" Text="" Margin="5"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
